# Imbewu Learn API Configuration
# Copy this file to .env and fill in with your actual values
# NEVER commit .env to version control

# Server Configuration
PORT=3000
NODE_ENV=development

# Microsoft Foundry Configuration
# Get these from your Azure portal
AZURE_FOUNDRY_KEY=your-foundry-api-key-here
AZURE_FOUNDRY_ENDPOINT=https://your-foundry-instance.openai.azure.com/
AZURE_FOUNDRY_DEPLOYMENT=imbewu-agent
AZURE_API_VERSION=2024-02-15-preview

# Azure AI Search Configuration (for knowledge base retrieval)
AZURE_SEARCH_KEY=your-search-service-key-here
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net/
AZURE_SEARCH_INDEX=imbewu-knowledge

# Frontend URL (for CORS)
FRONTEND_URL=https://yanele22.github.io/Imbewu-Learn

# Session Management
SESSION_TIMEOUT_MINUTES=30
MAX_SESSIONS=10000

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/api.log
