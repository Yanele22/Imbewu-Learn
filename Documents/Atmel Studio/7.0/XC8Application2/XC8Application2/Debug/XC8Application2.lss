void LCD_Send4Bit(uint8_t data) {
	// Isolate current PORTD lower pins (UART lines), overwrite top nibble space
	PORTD = (PORTD & 0xC3) | ((data & 0x10) << 1) | ((data & 0x20) >> 1) | ((data & 0x40) >> 3) | ((data & 0x80) >> 5);
