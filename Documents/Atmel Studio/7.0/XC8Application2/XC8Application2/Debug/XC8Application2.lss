// ================= BARE-METAL LCD DRIVER =================
// D4->PD5, D5->PD4, D6->PD3, D7->PD2 (PORTD bits shifted via mask layout)
// RS->PB0, EN->PB3 (PORTB control lines)

void LCD_Enable(void) {
	PORTB |= (1<<PB3);   // EN High
